  "private": true,
  "scripts": {
    "changelog": "node scripts/build-changelog.mjs",
    "posts": "node scripts/build-posts.mjs",
    "knowledge": "dotenv -e .env.local -- node scripts/build-knowledge.mjs",
    "predev": "npm run changelog && npm run posts",
    "dev": "next dev",
    "prebuild": "npm run changelog && npm run posts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run lint:fix && npm run format",
    "pretest": "npm run changelog && npm run posts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@next/third-parties": "^16.3.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "next": "^16",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^6",
    "unpdf": "^1.8.1",
    "vitest": "^4.1.10"
  },
